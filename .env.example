# kGPT Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider Settings
# =============================================================================

# Default LLM provider: openrouter, openai, anthropic, or ollama
LLM_PROVIDER=openrouter

# Default model (provider-specific)
LLM_MODEL=anthropic/claude-3.7-sonnet

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# OpenRouter (recommended - access all models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (direct)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Ollama (local LLM)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.3

# =============================================================================
# Embedding Settings
# =============================================================================

# Embedding provider: fastembed (local), openai, ollama, or cohere
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# For OpenAI embeddings:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# Cohere (for reranking)
COHERE_API_KEY=

# =============================================================================
# Vector Database (Qdrant)
# =============================================================================

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kgpt_docs

# =============================================================================
# Application Settings
# =============================================================================

# Enable debug mode
DEBUG=false

# Data directory for SQLite and logs
DATA_DIR=data

# =============================================================================
# Kafka Cluster (Optional)
# =============================================================================

# Bootstrap servers for Kafka cluster connection
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
